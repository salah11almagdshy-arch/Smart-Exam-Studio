  "fixed_sql": [
    {
      "name": "exams",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"exams\" (\"id\" TEXT NOT NULL, \"title\" TEXT NOT NULL, \"description\" TEXT NULL, \"subject\" TEXT NULL, \"duration_minutes\" INTEGER NULL, \"total_marks\" INTEGER NOT NULL DEFAULT 0, \"created_at\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "exam_sections",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"exam_sections\" (\"id\" TEXT NOT NULL, \"exam_id\" TEXT NOT NULL REFERENCES exams (id) ON DELETE CASCADE, \"title\" TEXT NOT NULL, \"description\" TEXT NULL, \"order_index\" INTEGER NOT NULL, \"created_at\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "questions",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"questions\" (\"id\" TEXT NOT NULL, \"section_id\" TEXT NOT NULL REFERENCES exam_sections (id) ON DELETE CASCADE, \"question_type\" TEXT NOT NULL, \"content_json\" TEXT NOT NULL, \"answer_json\" TEXT NULL, \"explanation_json\" TEXT NULL, \"marks\" INTEGER NOT NULL DEFAULT 1, \"order_index\" INTEGER NOT NULL, \"difficulty\" INTEGER NULL, \"bloom_level\" TEXT NULL, \"created_at\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "question_options",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"question_options\" (\"id\" TEXT NOT NULL, \"question_id\" TEXT NOT NULL REFERENCES questions (id) ON DELETE CASCADE, \"content_json\" TEXT NOT NULL, \"is_correct\" INTEGER NOT NULL DEFAULT 0 CHECK (\"is_correct\" IN (0, 1)), \"order_index\" INTEGER NOT NULL, \"created_at\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    }
  ]
